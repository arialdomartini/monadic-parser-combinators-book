
#let division-line() = {
    align(center)[
        #line(
            length: 80%,
            stroke: 3pt + rgb("#000000")
        )]}

#let chapter-intro(title, content, logo) = {

    [= #title]
    
    division-line()

    let img = image(logo, width: 110pt)

    let fig = figure(
        placement: top,
        img
    )

    
    v(2em)
    place(
        left,
        float: false,
        dx: -45pt,
        dy: -70pt,
        img
    )
        
    text(1.5em, content)
    

        division-line()


    h(2em)
    set text(1em, rgb("#555555"))
    set par(leading: 1.4em)

    
    // [
    //     - This function yields a Latin-like Lorem Ipsum blind.
    //     - text with the given number of words. The sequence of words generated by the function is always.
    //     - The same but randomly chosen.
    // ]
    pagebreak()
}

